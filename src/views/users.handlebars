<div id="view-users">

    <header class="py-3">
        <h1 class="text-center">Lista de usuarios</h1>
    </header>

    <main class="container">
        <section>
            {{#if users}}
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Apellido</th>
                            <th scope="col">Email</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="table-body">
                        {{#each users}}
                        <tr>
                            <th scope="row">{{id}}</th>
                            <td>{{firstname}}</td>
                            <td>{{lastname}}</td>
                            <td>{{email}}</td>
                            <td>
                                <a href="/users/profile/{{id}}" class="btn btn-info">Ver</a>
                                <a href="/users/edit/{{id}}" class="btn btn-warning">Editar</a>
                                <button class="btn btn-danger btn-eliminar" data-id-user="{{id}}">Eliminar</button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}
                <p class="text-center fs-2 fw-bold">No hay usuarios registrados
                    en el sistema.</p>
            {{/if}}

        </section>
    </main>

</div>

<script>
document.getElementById("table-body")?.addEventListener("click", async function(event) {
    const button = event.target.closest(".btn-danger");
    if (!button) return;
    const idUser = button.getAttribute("data-id-user");
    const response = await fetch("/api/users/" + idUser);
    const data = await response.json();
    if (response.ok) {
        const confirmDel = confirm(`¿Eliminar el usuario ${data.user.firstname} ${data.user.lastname} con email: ${data.user.email}?`);
        if (confirmDel) {
            const deleteResponse = await fetch("/api/users/" + idUser, { method: "DELETE" });
            const deleteData = await deleteResponse.json();
            if (deleteResponse.ok) {
                alert("Usuario eliminado correctamente.");
                location.reload();
            } else {
                alert("Error al eliminar el usuario: " + deleteData.message);
            }
        }
    } else {
        alert("Error al obtener el usuario: " + data.message);
        console.error("Error en el servidor. Código:", response.status);
    }
});
</script>